PORT=5000
LISTENING_GUARD_MS=350
TURN_END_GRACE_MS=800

SARVAM_API_KEY=your_sarvam_api_key
# Models must have verified entries in the capability manifest.
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
# Optional JSON manifest path; defaults to src/sarvam-capabilities.json.
SARVAM_CAPABILITIES_FILE=
ADMIN_TOKEN=your_internal_admin_token
DEMO_BUYER_PHONE=+91XXXXXXXXXX
EXOTEL_CONNECT_TOKEN=your_optional_connect_endpoint_token

# New Exotel account (Singapore region)
EXOTEL_ACCOUNT_SID=krishdev1
EXOTEL_API_KEY=dc54cced211e7915e3350d99633fbebf737c4295903b0db9
EXOTEL_API_TOKEN=a0192d903071485e03b4cdd5a2db9ed2ac675841d683c66d
EXOTEL_SUBDOMAIN=api.exotel.com

# Top-5 buyer/seller SMS delivery through Fast2SMS Quick SMS.
FAST2SMS_API_KEY=your_fast2sms_api_key

# Official Government of India AGMARKNET daily mandi-price API.
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Explicitly opt in only for demos. Production should keep this false.
MANDI_ALLOW_DEMO_FALLBACK=false

# Optional: override the default local SQLite path.
KISANSETU_DB_PATH=

# Optional legacy browser prototype integration.
GOOGLE_APPLICATION_CREDENTIALS=
